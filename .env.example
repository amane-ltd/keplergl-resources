# アクセス制限（パスワード）の設定
# このファイルをコピーして .env.local を作り、どちらか一方を設定してください。
# .env.local は .gitignore 済みです。

# 1) ハッシュを直接指定する（推奨）
#    node scripts/hash-password.js "パスワード"
#    で出力された文字列を貼り付けます。
ACCESS_PW_HASH=

# 2) 平文パスワードを置き、ビルド時にハッシュ化する
#    （手元ファイルに平文が残る点に注意）
# ACCESS_PASSWORD=

# 未設定のまま `npm run build` するとアクセス制限なしでビルドされます。
# `npm run deploy` は REQUIRE_ACCESS_GATE=1 が付くため、未設定だと失敗します。
